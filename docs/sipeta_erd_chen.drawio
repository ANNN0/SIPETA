        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USERS {\n        bigint id PK\n        varchar name\n        varchar email UK\n        varchar mobile\n        text image\n        varchar password\n        varchar utype\n        boolean is_blocked\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    CATEGORIES {\n        bigint id PK\n        varchar name\n        varchar slug UK\n        varchar image\n        varchar parent_id FK\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    REGIONS {\n        bigint id PK\n        varchar name\n        varchar slug UK\n        varchar province\n        text description\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    PRODUCT_TYPES {\n        bigint id PK\n        varchar name\n        varchar slug UK\n        text description\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    FARMERS {\n        bigint id PK\n        varchar name\n        varchar slug UK\n        varchar email\n        varchar phone\n        varchar location\n        bigint region_id FK\n        varchar certification\n        boolean is_active\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    PRODUCTS {\n        bigint id PK\n        varchar name\n        varchar slug UK\n        text description\n        decimal regular_price\n        decimal sale_price\n        varchar SKU\n        enum stock_status\n        int quantity\n        varchar image\n        bigint category_id FK\n        bigint region_id FK\n        bigint farmer_id FK\n        boolean is_organic\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    PRODUCT_PRODUCT_TYPE {\n        bigint id PK\n        bigint product_id FK\n        bigint product_type_id FK\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    ORDERS {\n        bigint id PK\n        bigint user_id FK\n        decimal subtotal\n        decimal discount\n        decimal tax\n        decimal total\n        varchar name\n        varchar phone\n        text address\n        varchar city\n        varchar state\n        varchar zip\n        enum status\n        date delivered_date\n        date canceled_date\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    SHOPPINGCART {\n        varchar identifier PK\n        bigint user_id FK\n        varchar instance\n        text content\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    ORDER_ITEMS {\n        bigint id PK\n        bigint product_id FK\n        bigint order_id FK\n        decimal price\n        int quantity\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    TRANSACTIONS {\n        bigint id PK\n        bigint user_id FK\n        bigint order_id FK\n        enum mode\n        enum status\n        varchar snap_token\n        varchar payment_id\n        varchar payment_type\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    RETURN_REQUESTS {\n        bigint id PK\n        bigint order_id FK\n        bigint user_id FK\n        varchar reason\n        text description\n        varchar solution\n        json photos\n        varchar contact_name\n        varchar contact_phone\n        text sender_address\n        varchar sender_city\n        varchar sender_state\n        varchar sender_zip\n        enum status\n        text admin_notes\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    CONTACTS {\n        bigint id PK\n        bigint user_id FK\n        varchar name\n        varchar email\n        varchar phone\n        text comment\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    USERS ||--o{ ORDERS : \&quot;places\&quot;\n    USERS ||--o{ TRANSACTIONS : \&quot;makes\&quot;\n    USERS ||--o{ SHOPPINGCART : \&quot;owns\&quot;\n    USERS ||--o{ CONTACTS : \&quot;submits\&quot;\n    USERS ||--o{ RETURN_REQUESTS : \&quot;requests\&quot;\n    CATEGORIES ||--o{ CATEGORIES : \&quot;parent of\&quot;\n    CATEGORIES ||--o{ PRODUCTS : \&quot;contains\&quot;\n    REGIONS ||--o{ PRODUCTS : \&quot;source of\&quot;\n    REGIONS ||--o{ FARMERS : \&quot;located in\&quot;\n    FARMERS ||--o{ PRODUCTS : \&quot;grows\&quot;\n    PRODUCTS ||--o{ PRODUCT_PRODUCT_TYPE : \&quot;has types\&quot;\n    PRODUCT_TYPES ||--o{ PRODUCT_PRODUCT_TYPE : \&quot;assigned to\&quot;\n    ORDERS ||--o{ ORDER_ITEMS : \&quot;contains\&quot;\n    ORDERS ||--|| TRANSACTIONS : \&quot;paid via\&quot;\n    ORDERS ||--o{ RETURN_REQUESTS : \&quot;has returns\&quot;\n    PRODUCTS ||--o{ ORDER_ITEMS : \&quot;ordered as\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zs1qeJEjadMktHeZ78fI-1">
